NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
SALT_ROUND=10

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

UPLOAD_MAX_FILE_SIZE_MB=2

FRONTEND_URL=http://localhost:3000

SENDGRID_API_KEY=SG.your-sendgrid-api-key
MAIL_FROM_EMAIL=your@email.com
MAIL_FROM_NAME=FounderLink

OTP_EXPIRES_IN=2m
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

PASSWORD_RESET_TOKEN_SECRET=your-password-reset-secret-change-in-production
PASSWORD_RESET_TOKEN_EXPIRES_IN=10m
